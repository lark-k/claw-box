<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>QuantumHarness</AssemblyName>
    <RootNamespace>ClawBox.Desktop</RootNamespace>
    <Product>Quantum Harness</Product>
    <ApplicationIcon>Assets/QuantumHarness.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/QuantumHarness.ico" />
    <Resource Include="Assets/QuantumHarness.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <ProjectReference Include="../ClawBox.Contracts/ClawBox.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../scripts/board/inspect-desktop.py" Link="SetupAssets/inspect-desktop.py" />
    <EmbeddedResource Include="../../scripts/board/inspect-network.py" Link="SetupAssets/inspect-network.py" />
    <EmbeddedResource Include="../../scripts/board/pair-desktop.py" Link="SetupAssets/pair-desktop.py" />
    <EmbeddedResource Include="../../scripts/board/recover-tunnel.py" Link="SetupAssets/recover-tunnel.py" />
    <EmbeddedResource Include="../../scripts/board/install-plugin.py" Link="SetupAssets/install-plugin.py" />
    <EmbeddedResource Include="../../scripts/board/configure-desktop.py" Link="SetupAssets/configure-desktop.py" />
    <EmbeddedResource Include="../ClawBox.OpenClawPlugin/package.json" Link="SetupAssets/package.json" />
    <EmbeddedResource Include="../ClawBox.OpenClawPlugin/openclaw.plugin.json" Link="SetupAssets/openclaw.plugin.json" />
    <EmbeddedResource Include="../ClawBox.OpenClawPlugin/index.js" Link="SetupAssets/index.js" />
    <EmbeddedResource Include="../ClawBox.OpenClawPlugin/client.js" Link="SetupAssets/client.js" />
  </ItemGroup>
</Project>
