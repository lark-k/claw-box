<Window x:Class="ClawBox.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClawBox.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Quantum Harness" Icon="pack://application:,,,/Assets/QuantumHarness.ico" Width="1480" Height="960" MinWidth="1050" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" Background="#F8F3F4" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <local:HeaderWidthConverter x:Key="HeaderWidth"/>
    <Style x:Key="HoverAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Visibility" Value="Hidden"/><Setter Property="Padding" Value="8"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="Workspace" TargetType="Expander">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="WorkspaceRow" Background="Transparent" CornerRadius="8" PreviewMouseRightButtonUp="Project_RightClick">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
              <ToggleButton x:Name="WorkspaceToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Padding="7,8" Cursor="Hand" FocusVisualStyle="{x:Null}" PreviewKeyDown="Project_MenuKeyDown">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <Button x:Name="WorkspaceNew" Grid.Column="1" Click="ProjectNew_Click" Tag="{Binding Path}" ToolTip="在此工作区新建聊天" AutomationProperties.Name="在此工作区新建聊天" IsEnabled="{Binding DataContext.CanManageChats, RelativeSource={RelativeSource AncestorType=Window}}" Padding="7">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=WorkspaceRow}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
              </Button>
            </Grid>
          </Border>
          <ContentPresenter x:Name="WorkspaceContent" Grid.Row="1" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
        </Grid><ControlTemplate.Triggers>
          <Trigger Property="IsExpanded" Value="True"><Setter TargetName="WorkspaceContent" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger SourceName="WorkspaceRow" Property="IsMouseOver" Value="True"><Setter TargetName="WorkspaceRow" Property="Background" Value="#EEEDEF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccessChip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#F06A22"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="7,5"/>
      <Setter Property="Background" Value="#F3F2F2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chip" CornerRadius="15" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/><ContentPresenter VerticalAlignment="Center"/></StackPanel>
        </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="#ECEBED"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <ContextMenu x:Key="AccessMenu" x:Shared="False" Width="404" Placement="Top" VerticalOffset="-4">
      <MenuItem Focusable="False" StaysOpenOnClick="True" Padding="10,6,10,8">
        <MenuItem.Template><ControlTemplate TargetType="MenuItem"><ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/></ControlTemplate></MenuItem.Template>
        <MenuItem.Header><DockPanel><Button DockPanel.Dock="Right" Click="AccessHelp_Click" Padding="0" Foreground="#929298" FontSize="11"><TextBlock Text="了解更多" TextDecorations="Underline"/></Button><TextBlock Text="应如何批准 Quantum 操作？" Foreground="#929298" FontSize="12" VerticalAlignment="Center"/></DockPanel></MenuItem.Header>
      </MenuItem>
      <MenuItem x:Name="RequestAccess" Tag="approval" Click="AccessMode_Click">
        <MenuItem.Icon><TextBlock Text="&#xE815;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#5B5C60"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="请求批准" FontSize="13"/><TextBlock Text="读取、修改文件和运行项目时逐次询问" Foreground="#96969C" FontSize="11" Margin="0,2,0,0"/></StackPanel></MenuItem.Header>
      </MenuItem>
      <MenuItem Tag="readOnly" Click="AccessMode_Click">
        <MenuItem.Icon><TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#5B5C60"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="只读访问" FontSize="13"/><TextBlock Text="仅批准读取；不允许修改或运行项目" Foreground="#96969C" FontSize="11" Margin="0,2,0,0"/></StackPanel></MenuItem.Header>
      </MenuItem>
      <MenuItem Tag="fullAccess" Click="AccessMode_Click" Foreground="#F06A22">
        <MenuItem.Icon><TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons" FontSize="18"/></MenuItem.Icon>
        <MenuItem.Header><StackPanel><TextBlock Text="完全访问权限" FontSize="13"/><TextBlock Text="自动批准当前工作区内的工具请求" FontSize="11" Margin="0,2,0,0"/></StackPanel></MenuItem.Header>
      </MenuItem>
    </ContextMenu>
    <Style x:Key="StopAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="ToolTip" Value="停止等待并请求取消"/><Setter Property="AutomationProperties.Name" Value="停止当前对话"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="StopSurface" Background="{TemplateBinding Background}" CornerRadius="17"><Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="White"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StopSurface" Property="Opacity" Value="0.86"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><DataTrigger Binding="{Binding IsResponding}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton FocusVisualStyle="{x:Null}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="2,5"><DockPanel>
              <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#8B898E" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
            <ContentPresenter Content="{TemplateBinding Header}"/>
          </ToggleButton>
          <ContentPresenter x:Name="ExpandedContent" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
        </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="InlineProgress" TargetType="Expander">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton x:Name="ProgressToggle" FocusVisualStyle="{x:Null}" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ToolIcon" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#929298" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" TextWrapping="Wrap" LineHeight="22" VerticalAlignment="Center"/>
                <TextBlock x:Name="InlineChevron" Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#929298" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="InlineChevron" Property="Text" Value="&#xE70D;"/></Trigger>
                <DataTrigger Binding="{Binding Detail}" Value=""><Setter TargetName="InlineChevron" Property="Visibility" Value="Collapsed"/></DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="InlineContent" Content="{TemplateBinding Content}" Visibility="Collapsed" Margin="0,6,0,0"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsExpanded" Value="True"><Setter TargetName="InlineContent" Property="Visibility" Value="Visible"/></Trigger>
          <DataTrigger Binding="{Binding Detail}" Value=""><Setter TargetName="ProgressToggle" Property="IsEnabled" Value="False"/><Setter TargetName="ProgressToggle" Property="Cursor" Value="Arrow"/><Setter Property="IsExpanded" Value="False"/></DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="17"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="ConversationItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,1"/><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EEECEE"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1EFF0"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <EventSetter Event="PreviewMouseRightButtonUp" Handler="Conversation_RightClick"/>
      <EventSetter Event="PreviewKeyDown" Handler="Conversation_MenuKeyDown"/>
    </Style>
    <DataTemplate x:Key="ConversationTemplate">
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="等待批准" Foreground="#1B9448" FontSize="10" Margin="6,0,0,0">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/><Condition Binding="{Binding DataContext.HasApprovals, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"/></DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="FileRow">
      <Expander Margin="0,2" HorizontalContentAlignment="Stretch">
        <Expander.Header><Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource HeaderWidth}}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding DisplayPath}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" Margin="0,7,8,7" FontSize="12"/>
          <TextBlock Grid.Column="1" Text="{Binding Added}" Foreground="#00A442" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Grid.Column="2" Text="{Binding Removed}" Foreground="#D62828" VerticalAlignment="Center"/>
        </Grid></Expander.Header>
        <StackPanel>
          <TextBlock Text="{Binding Note}" Foreground="#8A8A90" FontSize="11" Margin="12,4"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="300">
            <ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="{Binding Background}" Padding="8,2"><StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Number}" Width="35" Foreground="{Binding Foreground}" FontFamily="Consolas" FontSize="12"/>
                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontFamily="Consolas" FontSize="12"/>
              </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
          <Button Content="打开文件" Click="OpenResult_Click" Tag="{Binding Path}" FontSize="11" HorizontalAlignment="Left" Margin="6,4"/>
        </StackPanel>
      </Expander>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="文件" Click="Attach_Click" Padding="8,4"/><Button Content="变更" Click="ToggleTasks_Click" Padding="12,4"/><Button Content="帮助" Click="Help_Click" Padding="12,4"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Click="Minimize_Click" Width="46" AutomationProperties.Name="最小化"><TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="12"/></Button><Button Click="Maximize_Click" Width="46" AutomationProperties.Name="最大化"><TextBlock Style="{StaticResource Icon}" Text="&#xE922;" FontSize="12"/></Button><Button Click="Close_Click" Width="46" AutomationProperties.Name="关闭"><TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="12"/></Button></StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,6,0,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition x:Name="SidebarColumn" Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel Margin="4,6,4,0">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14"><Button Click="Settings_Click" Padding="12" ToolTip="连接与设置"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/></Button><Border Width="28" Height="28" CornerRadius="14" Background="#ED7028" Margin="0,10,0,0"><TextBlock Text="Q" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
        <StackPanel><Button Padding="12" Background="#E9E5E6" Click="Home_Click" ToolTip="聊天"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;"/></Button><Button Padding="12" Margin="0,10,0,0" Click="Workspace_Click" ToolTip="打开当前工作区"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;"/></Button></StackPanel>
      </DockPanel>
      <Border Grid.Column="1" Background="#FCFAFB" CornerRadius="18,0,0,18" BorderBrush="#E8E3E5" BorderThickness="1,1,0,1">
        <DockPanel Margin="12,18,12,12">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="6,0,0,18">
              <Image Source="pack://application:,,,/Assets/QuantumHarness.png" Width="28" Height="28" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Quantum Harness 应用图标"/>
              <TextBlock Text="Quantum Harness" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Click="New_Click" HorizontalAlignment="Left" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Margin="0,0,10,0"/><TextBlock Text="新聊天"/></StackPanel></Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button Content="{Binding ConnectionButtonLabel}" Click="Connect_Click" Background="#EEECEE" ToolTip="{Binding Status}" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="#77717A" Margin="4,6,4,0" MaxHeight="100">
              <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <ScrollViewer FocusVisualStyle="{x:Null}" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Grid x:Name="ProjectsHeading" Background="Transparent" Margin="0,0,0,8"><Expander x:Name="ProjectsSection" Header="项目" IsExpanded="True" Margin="6,8,40,0" Foreground="#8B898E" FontWeight="SemiBold"/><Button x:Name="AddProjectButton" Style="{StaticResource HoverAction}" HorizontalAlignment="Right" Click="Project_Click" ToolTip="添加项目工作区" AutomationProperties.Name="添加项目" IsEnabled="{Binding CanManageChats}"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="15"/></Button></Grid>
              <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=ProjectsSection}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Expander x:Name="WorkspaceGroup" Style="{StaticResource Workspace}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Margin="4,4,0,10">
                    <Expander.Header><DockPanel ToolTip="{Binding Path}"><TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DockPanel></Expander.Header>
                    <ListBox FocusVisualStyle="{x:Null}" ItemsSource="{Binding Conversations}" ItemContainerStyle="{StaticResource ConversationItem}" ItemTemplate="{StaticResource ConversationTemplate}" BorderThickness="0" Background="Transparent" Margin="18,0,0,0" SelectionChanged="Conversation_SelectionChanged" Loaded="ConversationList_Loaded" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                  </Expander>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid x:Name="RecentHeading" Background="Transparent" Margin="0,12,0,8"><Expander x:Name="RecentSection" Header="最近" IsExpanded="True" Margin="6,8,40,0" Foreground="#8B898E" FontWeight="SemiBold"/><Button x:Name="RecentNewButton" Style="{StaticResource HoverAction}" HorizontalAlignment="Right" Click="RecentNew_Click" ToolTip="在默认工作区新建聊天" AutomationProperties.Name="新建最近聊天" IsEnabled="{Binding CanManageChats}"><TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="15"/></Button></Grid>
              <ListBox x:Name="RecentList" FocusVisualStyle="{x:Null}" ItemsSource="{Binding Recent}" ItemContainerStyle="{StaticResource ConversationItem}" ItemTemplate="{StaticResource ConversationTemplate}" BorderThickness="0" Background="Transparent" SelectionChanged="Conversation_SelectionChanged" Loaded="ConversationList_Loaded" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=RecentSection}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
              </ListBox>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="0,18,18,0" BorderBrush="#E8E3E5" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DockPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,12,0"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspacePath}"/></DockPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="盒子已连接" Foreground="#339B5B" FontSize="11" Margin="0,0,8,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Click="ToggleTasks_Click" ToolTip="查看本轮文件变更" AutomationProperties.Name="文件变更"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;"/></Button></StackPanel>
          </Grid>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="TaskColumn" Width="0"/></Grid.ColumnDefinitions>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="920" Margin="32,16,32,18">
                  <StackPanel x:Name="Welcome" Margin="0,76,0,30"><TextBlock Text="把想法，变成完成的工作。" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="描述你的需求，Quantum 为你整理文档、开发代码。" Foreground="#838087" FontSize="13" TextWrapping="Wrap"/><WrapPanel Margin="0,24,0,0"><Button Content="整理文本内容" Click="Suggestion_Click" Tag="请读取我选择的文本文件，梳理重点并给出摘要。" Background="#F6F5F6" Margin="0,0,8,8"/><Button Content="生成 Word 文档" Click="Suggestion_Click" Tag="请根据我提供的内容，在工作目录中新建一份 Word 文档。" Background="#F6F5F6" Margin="0,0,8,8"/><Button Content="开发项目功能" Click="Suggestion_Click" Tag="请分析我选择的项目，根据需求实现功能并执行构建与测试。" Background="#F6F5F6" Margin="0,0,8,8"/></WrapPanel></StackPanel>
                  <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Margin="0,4,0,24">
                      <Expander x:Name="Activity" Header="{Binding Duration}" IsExpanded="{Binding ProgressExpanded, Mode=TwoWay}" Foreground="#929298" FontSize="12" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
                        <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="assistant"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                        <StackPanel>
                          <ItemsControl ItemsSource="{Binding ProgressEntries}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Grid x:Name="ProgressSurface" Margin="0,5,0,10">
                              <TextBlock x:Name="NarrationRow" Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="13" LineHeight="22" TextWrapping="Wrap"/>
                              <Expander x:Name="ProgressRow" Style="{StaticResource InlineProgress}" Header="{Binding Text}" Foreground="{Binding Foreground}" FontSize="13" Visibility="Collapsed">
                                <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MaxHeight="170" VerticalScrollBarVisibility="Auto" Background="#F6F6F7" BorderThickness="0"/>
                              </Expander>
                            </Grid>
                            <DataTemplate.Triggers>
                              <DataTrigger Binding="{Binding Text}" Value=""><Setter TargetName="ProgressSurface" Property="Visibility" Value="Collapsed"/></DataTrigger>
                              <DataTrigger Binding="{Binding Kind}" Value="tool"><Setter TargetName="NarrationRow" Property="Visibility" Value="Collapsed"/><Setter TargetName="ProgressRow" Property="Visibility" Value="Visible"/></DataTrigger>
                              <DataTrigger Binding="{Binding Kind}" Value="command"><Setter TargetName="NarrationRow" Property="Visibility" Value="Collapsed"/><Setter TargetName="ProgressRow" Property="Visibility" Value="Visible"/></DataTrigger>
                            </DataTemplate.Triggers>
                          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                          <ItemsControl ItemsSource="{Binding Activities}">
                            <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProgressEntries.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                            <ItemsControl.ItemTemplate><DataTemplate><Expander Style="{StaticResource InlineProgress}" Header="{Binding Description}" Foreground="#8A8A90" FontSize="12" Margin="0,5" HorizontalContentAlignment="Stretch"><TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MaxHeight="170" VerticalScrollBarVisibility="Auto" Background="#F6F6F7" BorderThickness="0"/></Expander></DataTemplate></ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Expander>
                      <Border x:Name="MessageSurface" CornerRadius="18" Padding="0">
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasText}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <Grid><local:MarkdownText x:Name="ReplyText" Markdown="{Binding DisplayText}" TextWrapping="Wrap" FontSize="14" LineHeight="24"/>
                          <TextBlock x:Name="UserText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="24" Visibility="Collapsed"/>
                        </Grid>
                      </Border>
                      <local:ThinkingIndicator Active="{Binding IsThinking}" Text="{Binding ProcessingLabel}" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Left">
                        <local:ThinkingIndicator.Style><Style TargetType="local:ThinkingIndicator"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsProcessing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:ThinkingIndicator.Style>
                      </local:ThinkingIndicator>
                      <TextBlock Text="{Binding WaitingHint}" TextWrapping="Wrap" FontSize="11" Foreground="#A0A0A5" Margin="0,4,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding WaitingHint}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                      </TextBlock>
                      <Border x:Name="ChangeSummary" CornerRadius="14" BorderBrush="#E9E7EA" BorderThickness="1" Margin="0,12,0,0" Padding="12">
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Changes.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="查看变更" Click="ToggleTasks_Click" FontSize="11" Background="#F7F7F8"/><TextBlock Text="{Binding Changes.Count, StringFormat=已更改 {0} 个文件}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource FileRow}" Margin="0,8,0,0"/></StackPanel>
                      </Border>
                    </StackPanel>
                    <DataTemplate.Triggers><DataTrigger Binding="{Binding Role}" Value="user"><Setter TargetName="ReplyText" Property="Visibility" Value="Collapsed"/><Setter TargetName="UserText" Property="Visibility" Value="Visible"/><Setter TargetName="MessageSurface" Property="Background" Value="#E8F2FF"/><Setter TargetName="MessageSurface" Property="Padding" Value="16,10"/><Setter TargetName="MessageSurface" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="MessageSurface" Property="MaxWidth" Value="720"/><Setter TargetName="MessageSurface" Property="TextElement.Foreground" Value="#173A5E"/></DataTrigger></DataTemplate.Triggers>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="1" Margin="28,10,28,14" MaxWidth="920">
                <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="#79717D" FontSize="11" Margin="0,2,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <ItemsControl ItemsSource="{Binding VisibleApprovals}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border Background="White" BorderBrush="#E3E4E6" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                      <TextBlock Text="允许执行这次操作吗？" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Tool}" FontFamily="Consolas" Foreground="#85858C" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,8"/>
                      <Expander Header="完整参数" HorizontalContentAlignment="Stretch"><TextBox Text="{Binding Parameters, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MaxHeight="130" VerticalScrollBarVisibility="Auto" Background="#F6F6F7" BorderThickness="0"/></Expander>
                      <TextBlock Text="{Binding Expiry}" FontSize="10" Foreground="#9B9BA0" Margin="0,5"/><TextBlock Text="{Binding Digest}" FontFamily="Consolas" FontSize="9" Foreground="#9B9BA0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Digest}"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="拒绝" Click="Reject_Click" Tag="{Binding}" IsEnabled="{Binding CanReject}" Margin="0,0,8,0"/><Button Content="批准这次请求" Click="Approve_Click" Tag="{Binding}" IsEnabled="{Binding CanDecide}" Background="#252628" Foreground="White"/></StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Grid Margin="4,0,16,4">
                  <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasApprovals}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                  <StackPanel Orientation="Horizontal"><Button Content="{Binding AccessLabel}" Style="{StaticResource AccessChip}" ContextMenu="{StaticResource AccessMenu}" Click="Access_Click"/><TextBlock Text="{Binding Approvals.Count, StringFormat=等待批准（{0}）}" FontSize="11" Foreground="#929298" VerticalAlignment="Center" Margin="10,0"/></StackPanel>
                  <Button x:Name="ApprovalStopButton" HorizontalAlignment="Right" Style="{StaticResource StopAction}" Click="Stop_Click"/>
                </Grid>
                <Border x:Name="ComposerSurface" CornerRadius="22" BorderBrush="#E9E7EA" BorderThickness="1" Background="White" Padding="16,12">
                  <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasApprovals}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <Border.Effect><DropShadowEffect Color="#BEB7C0" Opacity="0.1" BlurRadius="18" ShadowDepth="2"/></Border.Effect>
                  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                    <TextBox x:Name="Composer" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="输入任务" BorderThickness="0" Background="Transparent" Padding="0,0,0,10" MinHeight="50" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Composer_KeyDown" FontSize="14"/>
                    <TextBlock Text="输入任务，或选择文件开始…" Foreground="#A29CA5" FontSize="14" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Input}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><DockPanel Grid.Row="1">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button ToolTip="{Binding ContextInfo}" Padding="8" AutomationProperties.Name="上下文窗口信息"><TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="14"/></Button><TextBlock Text="Qwen · 盒子智能体" Foreground="#78727C" FontSize="11" VerticalAlignment="Center" Margin="4,0,10,0"/>
                        <Grid Width="34" Height="34"><Button x:Name="SendButton" Click="Send_Click" IsEnabled="{Binding CanSend}" Background="{StaticResource Accent}" Padding="7" ToolTip="发送（Ctrl+Enter）"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsResponding}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" Foreground="White" FontSize="18"/></Button><Button x:Name="StopButton" Style="{StaticResource StopAction}" Click="Stop_Click"/></Grid>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal"><Button Click="Attach_Click" ToolTip="选择文件" Padding="0,6,8,6"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;"/></Button><Button x:Name="AccessButton" Content="{Binding AccessLabel}" Style="{StaticResource AccessChip}" ContextMenu="{StaticResource AccessMenu}" Click="Access_Click" ToolTip="访问权限"/></StackPanel>
                    </DockPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>
            <Border x:Name="TaskPane" Grid.Column="1" BorderBrush="#EFEBED" BorderThickness="1,0,0,0" Background="White">
              <DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel Margin="14,8"><Button DockPanel.Dock="Right" Click="ToggleTasks_Click" ToolTip="关闭变更" Padding="6"><TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="12"/></Button><TextBlock Text="变更" VerticalAlignment="Center" FontSize="14"/></DockPanel><Border BorderBrush="#EFEBED" BorderThickness="0,1,0,1" Padding="14,10"><TextBlock Text="{Binding ChangeTotals}" FontSize="12"/></Border></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10,8"><TextBlock Text="本轮尚无文件变更" Foreground="#929298" Margin="8,12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Changes.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ItemsControl ItemsSource="{Binding Changes}" ItemTemplate="{StaticResource FileRow}"/></StackPanel></ScrollViewer></DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
